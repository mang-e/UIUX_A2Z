/* A2Z 놀거리(play.html) 전용 스타일 — 말랑이 · 왁뿌볼 · 클리커 · 동묘 쇼핑. style.css 다음에 불러와요. */

.blob.sq{transform:scale(1.35,.6)}
.key{width:clamp(56px,10vw,84px);aspect-ratio:1;border-radius:var(--r-card);font-weight:800;font-size:20px;color:var(--ink);box-shadow:inset 0 0 0 2px var(--ink),0 6px 0 var(--g4);transition:.06s}
.key.dn,.key:active{transform:translateY(6px);box-shadow:inset 0 0 0 2px var(--ink),0 0 0 var(--g4)}
.tgc{width:min(520px,100%);height:min(340px,48vh);touch-action:none;background:var(--paper);border-radius:var(--r-card-lg);box-shadow:inset 0 0 0 2px var(--ink);cursor:grab}
.waxwrap{position:relative;display:grid;place-items:center}
.wax{position:relative;width:min(240px,56vw,34vh);aspect-ratio:1;border-radius:50%;background:var(--c);box-shadow:inset 0 0 0 2px var(--ink);transition:transform .18s cubic-bezier(.2,.8,.3,1.4);touch-action:none;cursor:pointer}
.wax.sq{transform:scale(1.14,.86)}
.wax.bn{animation:bn .7s}
.shell{position:absolute;inset:0;border-radius:50%;background:color-mix(in srgb,var(--c) 38%,#FEFEFE);box-shadow:inset 0 0 0 2px var(--ink)}
.shell::after{content:"";position:absolute;left:18%;top:15%;width:26%;height:13%;border-radius:50%;background:#fff;opacity:.85;rotate:-28deg}
.shell svg{position:absolute;inset:0;width:100%;height:100%}
.shell path{opacity:0;transition:opacity .15s}
.l1 .k1,.l2 .k2,.l3 .k3{opacity:.8}
.shard{position:absolute;left:50%;top:50%;margin:-13px 0 0 -13px;width:26px;height:26px;background:color-mix(in srgb,var(--c) 38%,#FEFEFE);clip-path:polygon(50% 0,100% 100%,0 80%);animation:shard 1s ease-out forwards;pointer-events:none}
.shelf{grid-template-columns:repeat(3,1fr)}
.item{background:var(--paper);border-radius:var(--r-card);padding:12px 8px;text-align:center;color:var(--ink);box-shadow:inset 0 0 0 2px var(--ink);transition:.15s}
.item .ic{width:46px;margin:0 auto 4px}
.item small{display:block;font-size:12px;font-weight:800;line-height:1.4}
.item.q{font-size:34px;color:var(--g3);padding:18px 8px}
.item:hover{rotate:-2deg}
.item.in{background:var(--pc);color:var(--pt)}
/* ---------- 인터랙션 부품 ---------- */
.sqwrap{width:min(250px,62vw);aspect-ratio:1}
.sq3{width:100%;height:100%;transform-origin:50% 92%;touch-action:none;cursor:grab;overflow:visible}
.thumbs{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.thb{width:46px;height:46px;padding:5px;border-radius:var(--r-card);background:var(--paper);box-shadow:inset 0 0 0 2px var(--ink)}
.thb.on{background:var(--pc)}
.thb .th{width:100%;height:100%}
.clkwrap{position:relative;display:grid;place-items:center;width:100%}
.clk{width:clamp(130px,26vw,190px);transition:transform .1s}
.clk:active{transform:scale(.92)}
.fl{position:absolute;top:10%;font-weight:800;font-size:20px;animation:rise .8s ease-out forwards;pointer-events:none}
.crew2{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.cc{width:46px;height:46px;padding:4px;border-radius:var(--r-card);background:var(--paper);box-shadow:inset 0 0 0 2px var(--ink)}
.cc.on{background:var(--pc)}
.cc.lock{filter:brightness(0);opacity:.25}
.ups{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;width:min(420px,100%)}
.upg{padding:8px 12px;text-align:left;border-radius:var(--r-card);background:var(--paper);box-shadow:inset 0 0 0 2px var(--ink);font-size:13px;line-height:1.4}
.upg small{display:block;font-weight:500;font-size:11px}
.upg:disabled{opacity:.4;cursor:default}
.aw{width:min(420px,100%);height:40px;display:block}
.stallname{font-weight:800;font-size:15px}
.item.pick{rotate:0deg;background:var(--ps);box-shadow:inset 0 0 0 3px var(--pc)}
.deal{min-height:62px;text-align:center;font-size:14px}
.deal .chip:hover{background:var(--pc);color:var(--pt)}
.deal .chip:disabled{opacity:.35}
.receipt{width:min(280px,90%);background:#fff;padding:20px 18px;font-size:13px;line-height:1.7;text-align:center;box-shadow:inset 0 0 0 2px var(--ink);border-radius:6px}
.receipt h4{font-size:16px;font-weight:800}
.receipt hr{border:0;border-top:2px dashed var(--g2);margin:10px 0}
.rl{display:flex;justify-content:space-between;text-align:left}
@keyframes shard{to{transform:translate(var(--x),var(--y)) rotate(var(--r));opacity:0}}
@keyframes rise{to{transform:translateY(-70px);opacity:0}}
